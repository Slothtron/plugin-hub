{
  "description": "OpenViking memory hooks: profile/skill catalog injection at session start, per-prompt semantic recall, viking:// URI guard on local file tools, and turn capture on Stop. All entries route through with-user-config.mjs so UI-configured connection settings are the only override (env/config files are wiped by the bridge).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/scripts/with-user-config.mjs",
              "${ZCODE_PLUGIN_ROOT}/upstream/agent-hook-plugin/scripts/hook.mjs",
              "session-start",
              "zcode"
            ],
            "timeoutMs": 30000,
            "statusMessage": "openviking-memory: injecting profile & skills…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/scripts/with-user-config.mjs",
              "${ZCODE_PLUGIN_ROOT}/upstream/agent-hook-plugin/scripts/hook.mjs",
              "user-prompt-submit",
              "zcode"
            ],
            "timeoutMs": 20000,
            "statusMessage": "openviking-memory: recalling relevant memories…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/scripts/with-user-config.mjs",
              "${ZCODE_PLUGIN_ROOT}/upstream/agent-hook-plugin/scripts/uri-guard.mjs",
              "zcode"
            ],
            "timeoutMs": 5000,
            "statusMessage": "openviking-memory: guarding viking:// URIs…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/scripts/with-user-config.mjs",
              "${ZCODE_PLUGIN_ROOT}/upstream/agent-hook-plugin/scripts/hook.mjs",
              "stop",
              "zcode"
            ],
            "timeoutMs": 30000,
            "statusMessage": "openviking-memory: capturing finished turn…"
          }
        ]
      }
    ]
  }
}
