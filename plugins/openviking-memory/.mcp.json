{
  "mcpServers": {
    "openviking": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/scripts/with-user-config.mjs",
        "${ZCODE_PLUGIN_ROOT}/upstream/agent-hook-plugin/servers/mcp-proxy.mjs"
      ],
      "env": {
        "OPENVIKING_HOOK_SOURCE": "zcode"
      },
      "enabled": true,
      "timeoutMs": 30000
    }
  }
}
